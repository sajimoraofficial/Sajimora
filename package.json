{
  "name": "sajimora",
  "version": "0.1.0",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.5.0",
    "npm": ">=10.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "sajimora": "./bin/sajimora.cjs",
    "sajimora-v32": "./bin/sajimora.cjs"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "mcp:scoped": "node scripts/sajimora/mcpServer.cjs",
    "test:mcp:scoped": "node scripts/sajimora/mcpServer.test.cjs",
    "build": "tsc --noEmit --project tsconfig.json && esbuild scripts/sajimora/analyze.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/analyze.cjs --external:tree-sitter --external:tree-sitter-java --external:@mapbox/node-pre-gyp --external:node-gyp-build",
    "test": "npm run test:core && npm run test:production && npm run test:analysis && npm run test:phase3 && npm run test:phase4 && npm run test:change-intelligence && npm run test:impact && npm run test:cross-language",
    "test:core": "node scripts/test-runtime/run-tsx.cjs packages/core/tests/sajimora/VerdictAuthority.test.ts packages/core/tests/sajimora/AuthorityGateGoldens.test.ts packages/core/tests/sajimora/CompletenessAlgebra.test.ts",
    "test:production": "node scripts/test-runtime/run-tsx.cjs packages/core/tests/sajimora/ProductionVerificationCore.test.ts packages/analysis/tests/sajimora/TypeScriptGenericHardening.test.ts packages/analysis/tests/sajimora/TypeScriptProductionVerification.test.ts packages/analysis/tests/sajimora/TypeScriptProductionAdversarial.test.ts packages/analysis/tests/sajimora/TypeScriptPhase0Certification.test.ts packages/analysis/tests/sajimora/TypeScriptPhase1ASealedResolution.test.ts packages/analysis/tests/sajimora/TypeScriptPhase1BScopeIsolation.test.ts packages/analysis/tests/sajimora/TypeScriptPhase2ACallCompatibility.test.ts packages/analysis/tests/sajimora/TypeScriptPhase2BFiniteTypeReduction.test.ts packages/analysis/tests/sajimora/TypeScriptPhase3NonCallSpecializers.test.ts packages/analysis/tests/sajimora/TypeScriptPhase4OverloadCorrespondence.test.ts packages/analysis/tests/sajimora/TypeScriptPhase5MonorepoResolution.test.ts packages/analysis/tests/sajimora/TypeScriptPhase6RestrictedReactTsx.test.ts packages/analysis/tests/sajimora/TypeScriptPhase7RestrictedOperationalBehavior.test.ts packages/analysis/tests/sajimora/TypeScriptPhase8IntegratedPilotQualification.test.ts",
    "test:ts-phase0": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase0Certification.test.ts",
    "test:ts-phase1a": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase1ASealedResolution.test.ts",
    "test:ts-phase1b": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase1BScopeIsolation.test.ts",
    "test:ts-phase2a": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase2ACallCompatibility.test.ts",
    "test:ts-phase2b": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase2BFiniteTypeReduction.test.ts",
    "test:ts-phase3": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase3NonCallSpecializers.test.ts",
    "test:ts-phase4": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase4OverloadCorrespondence.test.ts",
    "test:ts-phase5": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase5MonorepoResolution.test.ts",
    "test:ts-phase6": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase6RestrictedReactTsx.test.ts",
    "test:ts-phase7": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase7RestrictedOperationalBehavior.test.ts",
    "test:ts-phase8": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/TypeScriptPhase8IntegratedPilotQualification.test.ts",
    "test:analysis": "npm run test:p0 && npm run test:adversarial && npm run test:multiproject && npm run test:blockers && npm run test:forced-limit",
    "test:p0": "tsx packages/analysis/tests/sajimora/P0AuditSuite.test.ts",
    "test:phase0": "node scripts/test-runtime/run-tsx.cjs packages/core/tests/sajimora/VerdictAuthority.test.ts packages/core/tests/sajimora/AuthorityGateGoldens.test.ts packages/analysis/tests/sajimora/P0AuditSuite.test.ts scripts/sajimora/cliArtifact.test.ts scripts/campaign/legacyRetirement.test.ts scripts/sajimora/phase0Readiness.test.ts",
    "test:phase1": "node scripts/test-runtime/run-tsx.cjs scripts/sajimora/phase1.test.ts",
    "test:phase2": "node scripts/test-runtime/run-tsx.cjs scripts/sajimora/phase2.test.ts scripts/sajimora/phase2-matrix.test.ts",
    "test:phase3-storage": "node scripts/test-runtime/run-tsx.cjs scripts/sajimora/phase3-storage.test.ts",
    "test:phase4-ingestion": "node scripts/test-runtime/run-tsx.cjs scripts/sajimora/phase4-ingestion.test.ts",
    "test:phase5-warm-query": "node scripts/test-runtime/run-tsx.cjs scripts/sajimora/phase5-warm-query.test.ts",
    "test:phase5-certified-contracts": "node scripts/test-runtime/run-tsx.cjs packages/core/tests/sajimora/certified/CanonicalEncoding.test.ts",
    "benchmark:warm-query": "node scripts/test-runtime/run-tsx.cjs scripts/campaign/benchmark_warm_indexed_query.ts",
    "test:advisory-impact": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/AdvisoryTypeScriptImpactAnalyzer.test.ts",
    "test:advisory-resolution": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/AdvisoryResolutionEngine.test.ts",
    "test:advisory-calibration-100": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/AdvisoryCalibration100.test.ts",
    "test:advisory": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/AdvisoryTypeScriptImpactAnalyzer.test.ts packages/analysis/tests/sajimora/AdvisoryResolutionEngine.test.ts packages/analysis/tests/sajimora/AdvisoryCalibration100.test.ts",
    "test:two-panel": "node scripts/test-runtime/run-tsx.cjs scripts/sajimora/twoPanelReport.test.ts",
    "test:cli:advisory": "node scripts/test-runtime/run-tsx.cjs scripts/sajimora/advisoryCli.test.ts",
    "campaign:10k": "node --max-old-space-size=4096 scripts/test-runtime/run-tsx-command.cjs scripts/campaign/run_10k_campaign.ts",
    "test:phase3": "node scripts/test-runtime/run-tsx.cjs scripts/sajimora/phase3.test.ts scripts/sajimora/phase3-matrix.test.ts scripts/sajimora/phase3-git-matrix.test.ts",
    "test:phase3:zod": "node scripts/test-runtime/run-tsx.cjs scripts/sajimora/zod-phase3-real.test.ts",
    "test:phase4": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/Phase4TestMatrix.test.ts scripts/sajimora/phase4.test.ts packages/analysis/tests/sajimora/Phase4HostileAuditGaps13.test.ts packages/analysis/tests/sajimora/Phase4HostileAuditGaps14.test.ts packages/analysis/tests/sajimora/Phase4HostileAuditRegressions.test.ts scripts/campaign/ProgramReuseGate.test.ts",
    "test:adversarial": "tsx packages/analysis/tests/sajimora/AdversarialMatrix.test.ts",
    "test:multiproject": "tsx packages/analysis/tests/sajimora/MultiProjectWorkspace.test.ts",
    "test:blockers": "tsx packages/analysis/tests/sajimora/ReleaseBlocker1Positive.test.ts && tsx packages/analysis/tests/sajimora/ReleaseBlocker1Negative.test.ts",
    "test:forced-limit": "tsx packages/analysis/tests/sajimora/V1ForcedLimit.test.ts",
    "test:change-intelligence": "npm run test --prefix packages/change-intelligence",
    "sajimora:analyze": "node scripts/test-runtime/run-tsx-command.cjs scripts/sajimora/analyze.ts",
    "sajimora:analyze:cross": "node scripts/test-runtime/run-tsx-command.cjs scripts/sajimora/analyzeCrossLanguage.ts",
    "test:cross-language": "node scripts/test-runtime/run-cross-language.cjs",
    "test:eval-classifier": "node scripts/test-runtime/run-tsx.cjs eval/liferay-unseen/verdictClassification.test.ts",
    "sajimora:analyze:java": "node scripts/test-runtime/run-tsx-command.cjs scripts/sajimora/analyzeJava.ts",
    "campaign:real": "node --max-old-space-size=8192 scripts/test-runtime/run-tsx-command.cjs scripts/campaign/run_real_campaign.ts",
    "campaign:real:ci": "node --max-old-space-size=8192 scripts/test-runtime/run-tsx-command.cjs scripts/campaign/run_real_campaign.ts --ci",
    "campaign:verify": "node scripts/test-runtime/run-tsx.cjs scripts/campaign/verify_campaign_quality.ts",
    "campaign:ts-caseb": "node --max-old-space-size=4096 scripts/test-runtime/run-tsx-command.cjs scripts/campaign/run_typescript_caseb_coverage_campaign.ts",
    "profile:phase4-memory": "node scripts/test-runtime/run-tsx-command.cjs scripts/campaign/phase4_memory_profile.ts",
    "campaign:cold": "node scripts/test-runtime/run-tsx-command.cjs scripts/campaign/runner_cold_start.ts",
    "test:impact": "npm run test --prefix packages/impact-analysis",
    "campaign:scale:java": "node --max-old-space-size=4096 scripts/test-runtime/run-tsx-command.cjs packages/analysis/tests/sajimora/JavaCampaignJ10B.test.ts",
    "test:java": "node scripts/test-runtime/run-tsx.cjs packages/analysis/tests/sajimora/JavaBuildFallback.test.ts packages/analysis/tests/sajimora/JavaPhase1BExtensions.test.ts packages/analysis/tests/sajimora/JavaGuardedAdditiveProofs.test.ts packages/analysis/tests/sajimora/JavaFrameworkScanner.test.ts packages/analysis/tests/sajimora/JavaPhase1AAliasFixtures.test.ts packages/analysis/tests/sajimora/JavaWildBaselineJ12.test.ts packages/analysis/tests/sajimora/JavaRealGitCommitQueries.test.ts packages/analysis/tests/sajimora/JavaF1CompilerJ11.test.ts packages/analysis/tests/sajimora/JavaAdversarialJ10C.test.ts packages/analysis/tests/sajimora/JavaPilotJ10A.test.ts packages/analysis/tests/sajimora/JavaCliIntegrationJ9.test.ts packages/analysis/tests/sajimora/JavaQualificationJ8_5.test.ts packages/analysis/tests/sajimora/JavaMultiModuleJ8.test.ts packages/analysis/tests/sajimora/JavaCertificationJ7.test.ts packages/analysis/tests/sajimora/JavaBenchmarkJ6.test.ts packages/analysis/tests/sajimora/JavaAdversarialJ6.test.ts packages/analysis/tests/sajimora/AdvisoryJavaImpactAnalyzer.test.ts packages/analysis/tests/sajimora/JavaCallSiteExtractionJ5.test.ts packages/impact-analysis/tests/java_extractor_j1.test.ts packages/impact-analysis/tests/java_type_ir_j2.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/react": "^19.3.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-java": "0.23.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "0.21.5",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
